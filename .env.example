ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me

# Optional: live VirusTotal IP reputation lookups.
# Get a free key at https://www.virustotal.com/gui/join-us (profile -> API key).
# Leave blank to keep using the simulated vt_risk/verdict already in the log file.
VT_API_KEY=

# Max NEW IPs to check per start-up (free tier: ~4/min, 500/day). Cached IPs are free.
VT_MAX_LOOKUPS=25
